{
  "functions": {
    "api/admin/**/*.js": {
      "includeFiles": "{content/events/**,components/site-nav.html,components/site-analytics.html,index.html,live-events.html}"
    }
  },
  "env": {
    "NODE_OPTIONS": "--disable-warning=DEP0169"
  },
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/content/courses/:path*",
      "destination": "/courses",
      "permanent": false
    }
  ]
}
