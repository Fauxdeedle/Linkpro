# Copy to .env and fill in from your Flute merchant dashboard
# Docs: https://developer.flute.com/docs/getting-started/api-keys

# Server (local dev)
PORT=8080
BASE_URL=http://localhost:8080

# Production (set in Vercel → Settings → Environment Variables)
# Optional on Vercel; VERCEL_URL is used automatically when this is unset.
# BASE_URL=https://yourdomain.com

# Flute API credentials (sandbox while developing)
FLUTE_CLIENT_ID=...
FLUTE_CLIENT_SECRET=...
FLUTE_ENVIRONMENT=sandbox
FLUTE_WEBHOOK_SECRET=whsec_...

# Course access. ACCESS_SECRET signs the login cookie (at least 16 characters).
# Upstash Redis keeps purchases. Without it, access lives only in this server process.
ACCESS_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional local store shared by `npm start` and scripts/grant-access.js
# ENTITLEMENT_FILE=./data/entitlements.json

# Login links for returning buyers (Resend)
RESEND_API_KEY=
ACCESS_EMAIL_FROM=LINK Pro <access@yourdomain.com>

# Optional: override product amounts (USD, whole dollars)
# FLUTE_AMOUNT_PELVIS_1=100
# FLUTE_AMOUNT_PELVIS_3=150
# FLUTE_AMOUNT_LLIP=199
# FLUTE_AMOUNT_SEMINAR_UPPER_LIMB=1500
# FLUTE_AMOUNT_SEMINAR_LOWER_LIMB=1500
# FLUTE_AMOUNT_SEMINAR_TRUNK_PELVIS=1500
# FLUTE_AMOUNT_SEMINAR_BUNDLE=3750
# FLUTE_AMOUNT_RETREAT_SHARED_BUNK=1350
# FLUTE_AMOUNT_RETREAT_KING_SINGLE=2350
# FLUTE_AMOUNT_RETREAT_KING_DOUBLE=3150

# Purchase sheet. Share the sheet with the service account as Editor.
# The Purchases tab headers are Timestamp, Email, Product, Product ID, Amount, Session ID.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# GOOGLE_SHEETS_TAB=Purchases

# Vercel webhook URL (after deploy):
# https://yourdomain.com/api/webhooks/flute
