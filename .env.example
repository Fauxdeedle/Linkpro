# Copy to .env and fill in from your Flute merchant dashboard
# Docs: https://developer.flute.com/docs/getting-started/api-keys

# Server (local dev)
PORT=8080
BASE_URL=http://localhost:8080

# Production (set in Vercel → Settings → Environment Variables)
# Optional on Vercel; VERCEL_URL is used automatically when this is unset.
# BASE_URL=https://yourdomain.com

# Flute API credentials (sandbox while developing)
FLUTE_CLIENT_ID=...
FLUTE_CLIENT_SECRET=...
FLUTE_ENVIRONMENT=sandbox
FLUTE_WEBHOOK_SECRET=whsec_...

# Optional: override product amounts (USD, whole dollars)
# FLUTE_AMOUNT_PELVIS_1=100
# FLUTE_AMOUNT_LLIP=199
# FLUTE_AMOUNT_SEMINAR_UPPER_LIMB=1500
# FLUTE_AMOUNT_SEMINAR_LOWER_LIMB=1500
# FLUTE_AMOUNT_SEMINAR_TRUNK_PELVIS=1500
# FLUTE_AMOUNT_SEMINAR_BUNDLE=3750
# FLUTE_AMOUNT_RETREAT_SHARED_BUNK=1350
# FLUTE_AMOUNT_RETREAT_KING_SINGLE=2350
# FLUTE_AMOUNT_RETREAT_KING_DOUBLE=3150

# Vercel webhook URL (after deploy):
# https://yourdomain.com/api/webhooks/flute
